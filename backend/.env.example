SMSBOWER_API_KEY=
# 多 Key 池（可选）：逗号分隔，非空时优先于 SMSBOWER_API_KEY。
# 每新建一个订单（取号 / 租 Gmail）取一把 Key，订单的查码与取消复用创建它的那把 Key。
SMSBOWER_API_KEYS=
# round_robin=每单取下一把（默认）| random=每单随机取一把
SMSBOWER_KEY_STRATEGY=round_robin
SMSBOWER_SERVICE=dr
SMSBOWER_COUNTRY=33
SMSBOWER_MAX_PRICE=0.05
# 同一个 Gmail 订单本地允许复用的最大轮次（防失控兜底；真实可收码次数由 SMSBower
# 的 available_to_get_next_code / 耗尽报错决定，留太大会在同一订单上空转）
SMSBOWER_GMAIL_ALIAS_CEILING=15
REGISTRATION_COUNTRY_ISO=CO
REGISTRATION_COUNTRY_DIALING_CODE=57
CONCURRENCY_LIMIT=3
# 批量注册调度：首个任务立即提交，后续任务使用短随机间隔；单位：秒
BATCH_SUBMIT_DELAY_MIN_SECONDS=0.2
BATCH_SUBMIT_DELAY_MAX_SECONDS=1.2
BATCH_POLL_INTERVAL_SECONDS=1.0
BATCH_IDLE_POLL_INTERVAL_SECONDS=1.0
DEFAULT_PROXY=http://127.0.0.1:7890
NEW_ACCOUNT_COOLDOWN_MINUTES=120
REGISTRATION_BIND_TOTP=false

# Sub2API 管理端上传（至少配置地址 + API Key 或 JWT）
SUB2API_BASE_URL=
SUB2API_REAUTH_REDIRECT_URI=
SUB2API_ADMIN_API_KEY=
SUB2API_JWT=
SUB2API_TIMEOUT=30
SUB2API_GROUP_IDS=
# 出口代理：Sub2API 部署侧常按出口 IP 地区准入，直连会被回 HTTP 403 REGION_NOT_SUPPORTED。
# 留空=沿用 DEFAULT_PROXY；填 direct=强制直连（自建/内网部署）。
SUB2API_PROXY=

# 邮箱 Provider（独立邮箱配置模块）
MAIL_PROVIDER=cf_temp_email
CF_TEMP_EMAIL_ENABLED=true
CF_TEMP_EMAIL_BASE_URL=https://temp-api.708651.xyz
CF_TEMP_EMAIL_DOMAIN=708651.xyz
# 地址来源：generated（自动创建）或 custom_pool（使用预配置邮箱池）
CF_TEMP_EMAIL_ADDRESS_MODE=generated
# custom_pool 模式：每行一个已转发到固定收件箱的邮箱地址
CF_TEMP_EMAIL_CUSTOM_POOL=
CF_TEMP_EMAIL_INBOX_ADDRESS=
# custom_pool 模式的固定收件箱 JWT；不会通过 API 回显
CF_TEMP_EMAIL_INBOX_JWT=
CF_TEMP_EMAIL_SITE_PASSWORD=
CF_TEMP_EMAIL_NAME_PREFIX=reg
CF_TEMP_EMAIL_RANDOM_LENGTH=10
CF_TEMP_EMAIL_POLL_INTERVAL=4
CF_TEMP_EMAIL_POLL_TIMEOUT=180
CF_TEMP_EMAIL_MAX_RETRIES=3
CF_TEMP_EMAIL_RATE_LIMIT_BACKOFF=10

OUTLOOK_ENABLED=false
OUTLOOK_MODE=manual_pool
OUTLOOK_ACCOUNTS_POOL=
OUTLOOK_POLL_INTERVAL=5
OUTLOOK_POLL_TIMEOUT=180
OUTLOOK_SENDER_FILTER=
OUTLOOK_SUBJECT_FILTER=
OUTLOOK_IMAP_HOST=outlook.office365.com
OUTLOOK_IMAP_PORT=993
OUTLOOK_IMAP_SSL=true
OUTLOOK_GRAPH_TENANT_ID=
OUTLOOK_GRAPH_CLIENT_ID=
OUTLOOK_GRAPH_CLIENT_SECRET=
CLASH_ROTATE_ENABLED=True
CLASH_CONTROLLER_URL=http://127.0.0.1:9097
CLASH_CONTROLLER_SECRET=set-your-secret
CLASH_SELECTOR_NAME=GLOBAL
CLASH_ROTATE_SETTLE_SECONDS=1.5
CLASH_ROTATE_MAX_ATTEMPTS=12
# 注册工作台轮换时只切名称含以下关键词的节点（这里是日本；逗号分隔，留空=不限制）
# 关键词必须和订阅里的实际节点名对得上，例：🇯🇵日本高速01 / 🇺🇸【北美洲】美国01原生
CLASH_ALLOWED_REGION_KEYWORDS=🇯🇵,日本,JP,Japan
# 节点延迟上限(ms)：主动/历史延迟超过该值视为不可用，跳过并切换下一个；0=不限制
CLASH_MAX_DELAY_MS=3000
# Codex OAuth 独立 Mihomo 实例（与注册工作台隔离，避免轮换互相打断）。留空=与注册共用
OAUTH_PROXY=http://127.0.0.1:7891
OAUTH_CLASH_CONTROLLER_URL=http://127.0.0.1:9098
OAUTH_CLASH_SELECTOR_NAME=GLOBAL
# OAuth 独立地区过滤（逗号分隔，留空=跟随 CLASH_ALLOWED_REGION_KEYWORDS）。
# 注册用日本、OAuth 用美国时，这里保持美国关键词。
OAUTH_CLASH_ALLOWED_REGION_KEYWORDS=🇺🇸,美国,US,United States
# 选择器名必须是「实际存在且能改变出口 IP」的策略组：
# - Clash 为 global 模式时，所有流量走 GLOBAL 组 → 填 GLOBAL；
# - 切回 rule（规则）模式时，openai.com / chatgpt.com 由 AI服务 组承载 → 填 AI服务。
# 组名写错不会报错，只会表现为「换节点未生效 / 出口 IP 未变化」，日志里有 ⚠ 提示。
